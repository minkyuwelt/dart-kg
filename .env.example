# OpenDART API 인증키 (https://opendart.fss.or.kr 에서 발급)
DART_API_KEY=

# DuckDB 파일 위치 (비우면 저장소 루트의 data/dartkg.duckdb)
DUCKDB_PATH=

# (Phase 3) 공시 원문 ZIP 보관 폴더 (비우면 저장소 루트의 data/documents)
DOCUMENTS_PATH=

# Neo4j 한국어 전문검색 실험(notebooks/neo4j_korean_fulltext_poc.py)용 포트. 비우면 17474·17687
# 다른 프로젝트 컨테이너가 7474·7687을 쓰고 있어서 기본값을 다르게 둠
NEO4J_POC_HTTP_PORT=
NEO4J_POC_BOLT_PORT=

# (Phase 3~) Neo4j (docker-compose.yml). 노트북 쪽 포트 — 7474·7687은 다른 수업이 쓰므로 기본 17474·17687
NEO4J_HTTP_PORT=
NEO4J_BOLT_PORT=
# Neo4j 비밀번호 — 반드시 적어야 컨테이너가 뜬다 (기본값 없음). 아무 긴 문자열이면 됨
NEO4J_PASSWORD=
# 메모리 (비우면 힙 2G, 페이지 캐시 4G — RAM 32GB 노트북 기준)
NEO4J_HEAP=
NEO4J_PAGECACHE=
