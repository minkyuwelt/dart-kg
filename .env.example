# OpenDART API 인증키 (https://opendart.fss.or.kr 에서 발급)
DART_API_KEY=

# DuckDB 파일 위치 (비우면 저장소 루트의 data/dartkg.duckdb)
DUCKDB_PATH=

# (Phase 3) 공시 원문 ZIP 보관 폴더 (비우면 저장소 루트의 data/documents)
DOCUMENTS_PATH=

# Neo4j 한국어 전문검색 실험(notebooks/neo4j_korean_fulltext_poc.py)용 포트. 비우면 17474·17687
# 다른 프로젝트 컨테이너가 7474·7687을 쓰고 있어서 기본값을 다르게 둠
NEO4J_POC_HTTP_PORT=
NEO4J_POC_BOLT_PORT=

# (Phase 3~) Neo4j (docker-compose.yml). 노트북 쪽 포트 — 7474·7687은 다른 수업이 쓰므로 기본 17474·17687
NEO4J_HTTP_PORT=
NEO4J_BOLT_PORT=
# Neo4j 비밀번호 — 반드시 적어야 컨테이너가 뜬다 (기본값 없음). 아무 긴 문자열이면 됨
NEO4J_PASSWORD=
# 메모리 (비우면 힙 2G, 페이지 캐시 4G — RAM 32GB 노트북 기준)
NEO4J_HEAP=
NEO4J_PAGECACHE=

# (Phase 3, 9b) LLM 답변 생성 — OpenAI. 노트북에서만 호출한다. 월 사용 한도를 OpenAI 콘솔에서 걸어 두기
OPENAI_API_KEY=
# 모델 (비우면 gpt-6-luna. 바꾸면 docs/decisions/0010에 이유를 적는다)
LLM_MODEL=
# 질문당 출력 토큰 상한(기본 2000), 그래프 관계표가 붙은 질문의 상한(기본 4000), 하루 호출 한도(기본 200, data/llm_calls.json에 기록)
LLM_MAX_OUTPUT_TOKENS=
LLM_MAX_OUTPUT_TOKENS_GRAPH=
LLM_DAILY_LIMIT=

# (Phase 3~4) API 서버. 검색기 이름은 eval.run과 같다 (기본 graph:hybrid:kure-v3 — 그래프 질문이 아니면 neo4j:hybrid:kure-v3와 같다). GPU 없는 서버를 흉내 내려면 API_EMBED_DEVICE=cpu
API_RETRIEVER=
API_EMBED_DEVICE=
# 화면(web/)이 API를 부를 때 허용할 출처. 쉼표로 여러 개. 비우면 노트북의 Vite 개발 서버(http://localhost:5173)만. Vercel에 올리면 그 주소를 적는다
API_CORS_ORIGINS=
