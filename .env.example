# OpenDART API 인증키 (https://opendart.fss.or.kr 에서 발급)
DART_API_KEY=

# PostgreSQL 접속 정보
# 노트북 터미널에서 스크립트를 실행할 때 기준 (예: localhost / 5432 / dartkg / dartkg)
# Airflow 컨테이너 안에서는 docker-compose.yml이 HOST=postgres, PORT=5432로 덮어쓴다
# 비밀번호에는 @ : / # 같은 특수문자를 쓰지 말 것 (Airflow DB 접속 주소가 깨짐)
POSTGRES_HOST=
POSTGRES_PORT=
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# Airflow (docker-compose)
# AIRFLOW_UID: WSL 터미널에서 `id -u` 결과 (보통 1000)
# AIRFLOW_JWT_SECRET: `python3 -c "import secrets; print(secrets.token_urlsafe(32))"` 결과
AIRFLOW_UID=
AIRFLOW_JWT_SECRET=
